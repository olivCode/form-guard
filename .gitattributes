* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary

# Keep developer files in Git, outside downloadable runtime distributions.
/.github export-ignore
/tests export-ignore
/tools export-ignore
/composer.lock export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/playwright.config.mjs export-ignore
/phpstan.neon export-ignore
/.php-cs-fixer.dist.php export-ignore
/docs/development.* export-ignore
/docs/testing.* export-ignore
/docs/accessibility-testing.* export-ignore
/CONTRIBUTING.* export-ignore
